meta {
  name: 1 - Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

docs {
  Crea un nuevo usuario. Devuelve 409 si el usuario ya existe (podés correrlo una sola vez, o cambiar el username en el environment).
}
